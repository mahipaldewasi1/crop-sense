# Copy this file to .env and fill in real values

PORT=5000

# Local MongoDB: mongodb://127.0.0.1:27017/cropsense
# OR MongoDB Atlas (free tier): mongodb+srv://<user>:<pass>@cluster.mongodb.net/cropsense
MONGO_URI=mongodb://127.0.0.1:27017/cropsense

# Any random long string, used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Later, when real AI model is ready (Python/FastAPI), put its URL here
AI_SERVICE_URL=http://localhost:8000/predict
